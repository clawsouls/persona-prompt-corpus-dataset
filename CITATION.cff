    affiliation: "ClawSouls, ModuLabs"
  - family-names: "Shin"
    given-names: "Eunji"
    affiliation: "ModuLabs"
keywords:
  - persona prompt
  - AI agent
  - mining software repositories
  - dataset
  - inter-rater agreement
